{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdaas.ticaret.gov.tr/schema.json",
  "title": "TC-PDAAS Ortak Şema",
  "description": "Üç katmanlı ekosistemin tamamını kapsayan JSON Schema",
  "version": "1.0.0",

  "$defs": {

    "gtipHam":       { "type": "string", "pattern": "^[0-9]{12}$" },
    "hizmetKodu":    { "type": "string", "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{2}$" },
    "parametreKodu": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "naceKodu":      { "type": "string", "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{2}$" },
    "cpaKodu":       { "type": "string", "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{2}$" },
    "tarih":         { "type": "string", "format": "date" },
    "iso8601":       { "type": "string", "format": "date-time" },

    "kurumMeta": {
      "type": "object",
      "required": ["giris_tarihi", "giren_kurum", "onay_durumu"],
      "properties": {
        "giris_tarihi":      { "$ref": "#/$defs/tarih" },
        "guncelleme_tarihi": { "$ref": "#/$defs/tarih" },
        "giren_kurum":       { "type": "string", "minLength": 1 },
        "giren_birim":       { "type": ["string", "null"] },
        "giren_kullanici":   { "type": ["string", "null"] },
        "onay_durumu":       { "type": "string", "enum": ["taslak", "onaylandi", "reddedildi", "arsiv"] },
        "onaylayan":         { "type": ["string", "null"] },
        "surum":             { "type": ["string", "null"] },
        "kaynak_belge":      { "type": ["string", "null"] },
        "not":               { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },

    "gecerlilik": {
      "type": "object",
      "required": ["gecerlilik_baslangic"],
      "properties": {
        "gecerlilik_baslangic": { "$ref": "#/$defs/tarih" },
        "gecerlilik_bitis":     { "type": ["string", "null"], "format": "date" }
      }
    },

    "genelParametreKaydi": {
      "type": "object",
      "required": ["gecerlilik_baslangic"],
      "properties": {
        "kod":                  { "type": ["string", "null"] },
        "ad":                   { "type": ["string", "null"] },
        "deger":                { "type": ["number", "string", "null"] },
        "oran":                 { "type": ["number", "null"] },
        "birim":                { "type": ["string", "null"] },
        "periyot":              { "type": ["string", "null"] },
        "para_birimi":          { "type": ["string", "null"] },
        "gecerlilik_baslangic": { "$ref": "#/$defs/tarih" },
        "gecerlilik_bitis":     { "type": ["string", "null"], "format": "date" },
        "notlar":               { "type": ["string", "null"] },
        "meta":                 { "$ref": "#/$defs/kurumMeta" }
      },
      "additionalProperties": true
    },

    "genelParametreDosyasi": {
      "type": "object",
      "required": ["surum", "kurum", "kategori", "parametre_adi", "sorumlu_kurum", "kayitlar"],
      "properties": {
        "surum":         { "type": "string" },
        "guncelleme":    { "$ref": "#/$defs/tarih" },
        "kurum":         { "type": "string" },
        "birim":         { "type": ["string", "null"] },
        "kategori":      { "type": "string", "enum": ["vergi", "sosyal", "faiz", "harclar", "ceza", "diger"] },
        "parametre_adi": { "$ref": "#/$defs/parametreKodu" },
        "aciklama":      { "type": "string" },
        "birim_kisaltma":{ "type": ["string", "null"] },
        "sorumlu_kurum": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
        "kaynak":        { "type": ["string", "null"] },
        "zaman_bazli":   { "type": "boolean", "default": true },
        "kayitlar": {
          "type": "array",
          "items": { "$ref": "#/$defs/genelParametreKaydi" }
        }
      },
      "additionalProperties": true
    },

    "gtipKaydi": {
      "type": "object",
      "required": ["gtip_ham", "kod", "aciklama", "fasil_no", "meta", "kurumlar"],
      "properties": {
        "gtip_ham":                     { "$ref": "#/$defs/gtipHam" },
        "kod":                          { "type": "string" },
        "aciklama":                     { "type": "string", "minLength": 1 },
        "olcu_birimi":                  { "type": ["string", "null"] },
        "fasil_no":                     { "type": "string", "pattern": "^[0-9]{2}$" },
        "pozisyon_no":                  { "type": ["string", "null"] },
        "alt_pozisyon_no":              { "type": ["string", "null"] },
        "cn_kodu":                      { "type": ["string", "null"] },
        "milli_alt_acilim_kodu":        { "type": ["string", "null"] },
        "istatistik_acilim_kodu":       { "type": ["string", "null"] },
        "seviye":                       { "type": "integer", "enum": [2, 4, 6, 8, 10, 12] },
        "yaprak_mi":                    { "type": "boolean" },
        "parent_alt_pozisyon_no":       { "type": ["string", "null"] },
        "parent_cn_kodu":               { "type": ["string", "null"] },
        "tam_yol":                      { "type": "string" },
        "etiketler":                    { "type": "array", "items": { "type": "string" } },
        "meta":                         { "type": "object" },
        "kurumlar":                     { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },

    "urunFasilDosyasi": {
      "type": "object",
      "required": ["meta", "kayitlar"],
      "properties": {
        "meta": {
          "type": "object",
          "required": ["fasil_no", "toplam_kayit", "yayin_durumu"],
          "properties": {
            "dosya_surumu":         { "type": "string" },
            "schema_surumu":        { "type": "string" },
            "surum":                { "type": "string" },
            "surum_onceki":         { "type": ["string", "null"] },
            "guncelleme":           { "$ref": "#/$defs/tarih" },
            "yayinci":              { "type": "string" },
            "birim":                { "type": ["string", "null"] },
            "kaynak":               { "type": "string" },
            "gecerlilik_baslangic": { "$ref": "#/$defs/tarih" },
            "gecerlilik_bitis":     { "$ref": "#/$defs/tarih" },
            "fasil_no":             { "type": "string", "pattern": "^[0-9]{2}$" },
            "fasil_adi":            { "type": "string" },
            "toplam_kayit":         { "type": "integer" },
            "toplam_yaprak":        { "type": "integer" },
            "yayin_durumu":         { "type": "string", "enum": ["taslak", "yayinda", "arsiv"] }
          }
        },
        "kayitlar": {
          "type": "array",
          "items": { "$ref": "#/$defs/gtipKaydi" }
        }
      }
    },

    "hizmetKaydi": {
      "type": "object",
      "required": ["hizmet_kodu", "aciklama"],
      "properties": {
        "hizmet_kodu":       { "$ref": "#/$defs/hizmetKodu" },
        "aciklama":          { "type": "string", "minLength": 1 },
        "grup_no":           { "type": ["string", "null"] },
        "grup_adi":          { "type": ["string", "null"] },
        "olcu_birimi":       { "type": ["string", "null"] },
        "meta":              { "type": "object" },
        "kurumlar":          { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },

    "hizmetGrupDosyasi": {
      "type": "object",
      "required": ["meta", "kayitlar"],
      "properties": {
        "meta":     { "type": "object" },
        "kayitlar": {
          "type": "array",
          "items": { "$ref": "#/$defs/hizmetKaydi" }
        }
      }
    },

    "manifestDosyasi": {
      "type": "object",
      "required": ["ad", "kisa_ad", "surum", "manifest_surumu"],
      "properties": {
        "ad":                  { "type": "string" },
        "kisa_ad":             { "type": "string" },
        "aciklama":            { "type": "string" },
        "surum":               { "type": "string" },
        "manifest_surumu":     { "type": "string" },
        "manifest_guncelleme": { "$ref": "#/$defs/iso8601" },
        "yayin_tarihi":        { "$ref": "#/$defs/tarih" },
        "kurum":               { "type": "string" },
        "lisans":              { "type": "string" }
      },
      "additionalProperties": true
    },

    "kurumManifestDosyasi": {
      "type": "object",
      "required": ["ad", "kurum", "manifest_surumu", "surum", "dosyalar"],
      "properties": {
        "ad":              { "type": "string" },
        "kisa_ad":         { "type": "string" },
        "kurum":           { "type": "string" },
        "birim":           { "type": ["string", "array", "null"] },
        "rol":             { "type": "string", "enum": ["veri_giren", "veri_tuketen", "yayinci"] },
        "surum":           { "type": "string" },
        "manifest_surumu": { "type": "string" },
        "guncelleme":      { "$ref": "#/$defs/tarih" },
        "dosyalar": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ad", "dosya", "yol", "surum", "durum"],
            "properties": {
              "ad":       { "type": "string" },
              "dosya":    { "type": "string" },
              "yol":      { "type": "string" },
              "surum":    { "type": "string" },
              "guncelleme": { "$ref": "#/$defs/tarih" },
              "kaynak":   { "type": ["string", "null"] },
              "durum":    { "type": "string", "enum": ["aktif", "taslak", "arsiv", "planlandi"] }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },

  "oneOf": [
    { "$ref": "#/$defs/genelParametreDosyasi" },
    { "$ref": "#/$defs/urunFasilDosyasi" },
    { "$ref": "#/$defs/hizmetGrupDosyasi" },
    { "$ref": "#/$defs/manifestDosyasi" },
    { "$ref": "#/$defs/kurumManifestDosyasi" }
  ],

  "examples": [
    {
      "aciklama": "Genel parametre dosyası örneği (KDV oranları)",
      "dosya": {
        "surum": "2026.01.01",
        "kurum": "T.C. Hazine ve Maliye Bakanlığı",
        "birim": "GİB",
        "kategori": "vergi",
        "parametre_adi": "kdv_oranlari",
        "aciklama": "Katma Değer Vergisi Oranları",
        "sorumlu_kurum": "GİB",
        "kaynak": "3065 Sayılı KDV Kanunu",
        "zaman_bazli": true,
        "kayitlar": [
          {
            "kod": "genel",
            "ad": "Genel KDV Oranı",
            "oran": 20.0,
            "birim": "%",
            "gecerlilik_baslangic": "2023-07-10",
            "gecerlilik_bitis": null
          }
        ]
      }
    },
    {
      "aciklama": "Ürün fasıl dosyası örneği (27. fasıl)",
      "dosya": {
        "meta": {
          "dosya_surumu": "1.0.0",
          "schema_surumu": "1.0.0",
          "surum": "2026.10.08",
          "yayinci": "T.C. Ticaret Bakanlığı",
          "fasil_no": "27",
          "fasil_adi": "Mineral Yakıtlar...",
          "toplam_kayit": 16,
          "toplam_yaprak": 16,
          "yayin_durumu": "yayinda"
        },
        "kayitlar": [
          {
            "gtip_ham": "270112100000",
            "kod": "2701.12.10.00.00",
            "aciklama": "Kokluk taşkömürü",
            "fasil_no": "27",
            "seviye": 12,
            "yaprak_mi": true,
            "meta": {},
            "kurumlar": {}
          }
        ]
      }
    }
  ]
}
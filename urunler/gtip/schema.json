{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdaas.ticaret.gov.tr/urunler/gtip/schema.json",
  "title": "GTİP Master Şeması",
  "description": "GTİP kaydı + otomatik eklenen kurum veri blokları. Ticaret Bakanlığı yayınlar, diğer kurumlar veri girer.",
  "version": "1.0.0",

  "$defs": {

    "gtipHam": {
      "type": "string",
      "pattern": "^[0-9]{12}$",
      "description": "12 haneli noktasız GTİP kodu"
    },

    "kodNoktali": {
      "type": "string",
      "pattern": "^[0-9]{2}\\.[0-9]{2}(\\.[0-9]{2})?(\\.[0-9]{2})?(\\.[0-9]{2})?$",
      "description": "Noktalı gösterim. Ara seviyelerde eksik basamak olabilir."
    },

    "tarih": {
      "type": "string",
      "format": "date",
      "examples": ["2026-01-15"]
    },

    "iso8601": {
      "type": "string",
      "format": "date-time"
    },

    "olcuBirimi": {
      "type": ["string", "null"],
      "enum": ["KG", "ADET", "LT", "M3", "M2", "CIFT", "TJ", "1000 kWs", "1000 m3", "m³ (1)", null]
    },

    "naceKodu": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{2}$",
      "examples": ["05.10.01", "19.10.01"]
    },

    "kurumMeta": {
      "type": "object",
      "description": "Her kurum bloğunun zorunlu meta bilgisi",
      "required": ["giris_tarihi", "giren_kurum", "onay_durumu"],
      "properties": {
        "giris_tarihi":      { "$ref": "#/$defs/tarih" },
        "guncelleme_tarihi": { "$ref": "#/$defs/tarih" },
        "giren_kurum":       { "type": "string", "minLength": 1 },
        "giren_birim":       { "type": ["string", "null"] },
        "giren_kullanici":   { "type": ["string", "null"] },
        "onaylayan":         { "type": ["string", "null"] },
        "onay_durumu": {
          "type": "string",
          "enum": ["taslak", "onaylandi", "reddedildi", "arsiv"]
        },
        "surum":             { "type": ["string", "null"] },
        "kaynak_belge":      { "type": ["string", "null"] },
        "not":               { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },

    "ikincilUrun": {
      "type": "object",
      "required": ["ad", "oran"],
      "properties": {
        "ad":       { "type": "string", "minLength": 1 },
        "gtip_ham": { "type": ["string", "null"], "pattern": "^[0-9]{12}$" },
        "oran":     { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },

    "randimanIliskisi": {
      "type": "object",
      "required": ["yon", "gtip_ham_karsi", "islem_adi", "asgari_randiman", "azami_fire"],
      "properties": {
        "yon": {
          "type": "string",
          "enum": ["girdi", "cikti"],
          "description": "Bu GTİP hammadde (girdi) mi yoksa mamul (cikti) mü?"
        },
        "gtip_ham_karsi":       { "$ref": "#/$defs/gtipHam" },
        "islem_adi":            { "type": "string", "minLength": 1 },
        "asgari_randiman":      { "type": "number", "minimum": 0, "maximum": 100 },
        "azami_fire":           { "type": "number", "minimum": 0, "maximum": 100 },
        "ikincil_urunler":      { "type": "array", "items": { "$ref": "#/$defs/ikincilUrun" }, "default": [] },
        "toplam_oran_kontrolu": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    },

    "kurumHazineMaliye": {
      "type": "object",
      "description": "T.C. Hazine ve Maliye Bakanlığı (GİB) verisi",
      "required": ["meta"],
      "properties": {
        "kdv_orani":                  { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "otv_orani":                  { "type": ["number", "string", "null"] },
        "otv_birimi":                 { "type": ["string", "null"] },
        "otv_durumu":                 { "type": ["string", "null"], "enum": ["muaf", "tabi", "kismi", null] },
        "tevkifat_kodu":              { "type": ["string", "null"] },
        "tevkifat_orani":             { "type": ["string", "null"] },
        "nace_kodu":                  { "$ref": "#/$defs/naceKodu" },
        "vergi_levhasi_faaliyet_kodu":{ "type": ["string", "null"] },
        "meta":                       { "$ref": "#/$defs/kurumMeta" }
      },
      "additionalProperties": true
    },

    "kurumTicaret": {
      "type": "object",
      "description": "T.C. Ticaret Bakanlığı (İthalat + İhracat + İç Ticaret + Tüketici)",
      "required": ["meta"],
      "properties": {
        "ithalat_rejimi": {
          "type": ["string", "null"],
          "enum": ["Serbest", "İzne Tabi", "Yasak", "Gözetim", "Kayda Tabi", null]
        },
        "ihracat_rejimi": {
          "type": ["string", "null"],
          "enum": ["Serbest", "İzne Tabi", "Yasak", "Kayda Tabi", null]
        },
        "gozetim_gerekli":              { "type": ["boolean", "null"] },
        "kota_kapsaminda":              { "type": ["boolean", "null"] },
        "gumruk_vergisi":               { "type": ["number", "null"], "minimum": 0 },
        "kdv_ithalat":                  { "type": ["number", "null"] },
        "tareks_kapsaminda":            { "type": ["boolean", "null"] },
        "tehlikeli_mi":                 { "type": ["boolean", "null"] },
        "tehlike_sinifi":               { "type": ["string", "null"] },
        "ihracatci_birligi":            { "type": ["string", "null"] },
        "borsa_tescil_zorunlu":         { "type": ["boolean", "null"] },
        "ozel_ulke_kisitlamalari":      { "type": "array", "items": { "type": "string" }, "default": [] },
        "randiman_iliskileri":          { "type": "array", "items": { "$ref": "#/$defs/randimanIliskisi" }, "default": [] },
        "meta":                         { "$ref": "#/$defs/kurumMeta" }
      },
      "additionalProperties": true
    },

    "kurumEnerji": {
      "type": "object",
      "description": "T.C. Enerji ve Tabii Kaynaklar Bakanlığı (MAPEG + EPDK)",
      "required": ["meta"],
      "properties": {
        "kalori_min_kcal_kg":  { "type": ["number", "null"], "minimum": 0 },
        "kalori_max_kcal_kg":  { "type": ["number", "null"], "minimum": 0 },
        "maden_ruhsati_gerekli": { "type": ["boolean", "null"] },
        "ruhsat_turu":         { "type": ["string", "null"] },
        "ruhsat_suresi_yil":   { "type": ["integer", "null"], "minimum": 0 },
        "maden_grubu":         { "type": ["string", "null"] },
        "fiyat_izleme":        { "type": ["boolean", "null"] },
        "stratejik_madde":     { "type": ["boolean", "null"] },
        "meta":                { "$ref": "#/$defs/kurumMeta" }
      },
      "additionalProperties": true
    },

    "kurumCevre": {
      "type": "object",
      "description": "T.C. Çevre, Şehircilik ve İklim Değişikliği Bakanlığı",
      "required": ["meta"],
      "properties": {
        "kukurt_max_yuzde":        { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "nem_max_yuzde":           { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "ced_gerekli":             { "type": ["boolean", "null"] },
        "ced_turu":                { "type": ["string", "null"] },
        "ced_esik_deger":          { "type": ["string", "null"] },
        "karbon_emisyon_kg_co2_ton": { "type": ["number", "null"], "minimum": 0 },
        "karbon_kapsam":           { "type": ["string", "null"] },
        "raporlama_zorunlu":       { "type": ["boolean", "null"] },
        "skdm_kapsaminda":         { "type": ["boolean", "null"] },
        "meta":                    { "$ref": "#/$defs/kurumMeta" }
      },
      "additionalProperties": true
    },

    "kurumSanayiTeknoloji": {
      "type": "object",
      "description": "T.C. Sanayi ve Teknoloji Bakanlığı (TSE)",
      "required": ["meta"],
      "properties": {
        "zorunlu_standart":    { "type": ["string", "null"] },
        "standart_adi":        { "type": ["string", "null"] },
        "tse_belgesi_gerekli": { "type": ["boolean", "null"] },
        "ilgili_standartlar":  { "type": "array", "items": { "type": "string" }, "default": [] },
        "meta":                { "$ref": "#/$defs/kurumMeta" }
      },
      "additionalProperties": true
    },

    "kurumUlastirma": {
      "type": "object",
      "description": "T.C. Ulaştırma ve Altyapı Bakanlığı (ADR/RID/IMDG)",
      "required": ["meta"],
      "properties": {
        "un_numarasi":        { "type": ["string", "null"] },
        "adr_sinifi":         { "type": ["string", "null"] },
        "sinif_adi":          { "type": ["string", "null"] },
        "ambalaj_grubu":      { "type": ["string", "null"] },
        "tunel_kisitlamasi":  { "type": ["string", "null"] },
        "ozel_hukumler":      { "type": "array", "items": { "type": "string" }, "default": [] },
        "meta":               { "$ref": "#/$defs/kurumMeta" }
      },
      "additionalProperties": true
    },

    "kurumCalismaSosyal": {
      "type": "object",
      "description": "T.C. Çalışma ve Sosyal Güvenlik Bakanlığı (İSG)",
      "required": ["meta"],
      "properties": {
        "isg_tehlike_sinifi": {
          "type": ["string", "null"],
          "enum": ["Az Tehlikeli", "Tehlikeli", "Çok Tehlikeli", null]
        },
        "zorunlu_belgeler": { "type": "array", "items": { "type": "string" }, "default": [] },
        "ozel_risk":        { "type": "array", "items": { "type": "string" }, "default": [] },
        "periyodik_kontrol":{ "type": ["string", "null"] },
        "meta":             { "$ref": "#/$defs/kurumMeta" }
      },
      "additionalProperties": true
    },

    "kurumTarimOrman": {
      "type": "object",
      "description": "T.C. Tarım ve Orman Bakanlığı",
      "required": ["meta"],
      "properties": {
        "gida_guvenligi_gerekli":  { "type": ["boolean", "null"] },
        "haccp_gerekli":           { "type": ["boolean", "null"] },
        "izlenebilirlik_gerekli":  { "type": ["boolean", "null"] },
        "organik_tarim_uygun":     { "type": ["boolean", "null"] },
        "kullanim_alanlari":       { "type": "array", "items": { "type": "string" }, "default": [] },
        "meta":                    { "$ref": "#/$defs/kurumMeta" }
      },
      "additionalProperties": true
    },

    "kurumSaglik": {
      "type": "object",
      "description": "T.C. Sağlık Bakanlığı (TİTCK)",
      "required": ["meta"],
      "properties": {
        "ruhsat_gerekli":  { "type": ["boolean", "null"] },
        "ruhsat_turu":     { "type": ["string", "null"] },
        "titck_kapsaminda":{ "type": ["boolean", "null"] },
        "meta":            { "$ref": "#/$defs/kurumMeta" }
      },
      "additionalProperties": true
    },

    "kurumTuik": {
      "type": "object",
      "description": "Türkiye İstatistik Kurumu — Sadece sistem tanımı, atama yapmaz",
      "properties": {
        "nace_katalog_kodu": { "$ref": "#/$defs/naceKodu" },
        "nace_aciklama":     { "type": ["string", "null"] },
        "cpa_kodu":          { "type": ["string", "null"] },
        "cpa_aciklama":      { "type": ["string", "null"] },
        "meta":              { "$ref": "#/$defs/kurumMeta" }
      },
      "additionalProperties": true
    },

    "kurumBloklari": {
      "type": "object",
      "description": "Hangi kurum veri girdiyse burada görünür. Boş başlar, otomatik büyür.",
      "properties": {
        "hazine_maliye":    { "$ref": "#/$defs/kurumHazineMaliye" },
        "ticaret":          { "$ref": "#/$defs/kurumTicaret" },
        "enerji":           { "$ref": "#/$defs/kurumEnerji" },
        "cevre":            { "$ref": "#/$defs/kurumCevre" },
        "sanayi_teknoloji": { "$ref": "#/$defs/kurumSanayiTeknoloji" },
        "ulastirma":        { "$ref": "#/$defs/kurumUlastirma" },
        "calisma_sosyal":   { "$ref": "#/$defs/kurumCalismaSosyal" },
        "tarim_orman":      { "$ref": "#/$defs/kurumTarimOrman" },
        "saglik":           { "$ref": "#/$defs/kurumSaglik" },
        "tuik":             { "$ref": "#/$defs/kurumTuik" }
      },
      "additionalProperties": true,
      "default": {}
    },

    "gtipMeta": {
      "type": "object",
      "description": "GTİP kaydı üst meta bilgisi (Ticaret Bakanlığı yayınlar)",
      "required": ["olusturma_tarihi", "kaynak", "yayinci"],
      "properties": {
        "olusturma_tarihi":  { "$ref": "#/$defs/tarih" },
        "guncelleme_tarihi": { "$ref": "#/$defs/tarih" },
        "kaynak":            { "type": "string", "minLength": 1 },
        "resmi_mi":          { "type": "boolean", "default": true },
        "yayinci":           { "type": "string", "minLength": 1 },
        "kaynak_belge_no":   { "type": ["string", "null"] },
        "notlar": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tarih", "kurum", "metin"],
            "properties": {
              "tarih": { "$ref": "#/$defs/tarih" },
              "kurum": { "type": "string" },
              "metin": { "type": "string" }
            }
          },
          "default": []
        }
      },
      "additionalProperties": true
    },

    "gtipKaydi": {
      "type": "object",
      "description": "Tek bir GTİP kaydı — GTİP master + kurum blokları",
      "required": ["gtip_ham", "kod", "aciklama", "fasil_no", "meta", "kurumlar"],
      "properties": {
        "gtip_ham":                    { "$ref": "#/$defs/gtipHam" },
        "kod":                         { "$ref": "#/$defs/kodNoktali" },
        "aciklama":                    { "type": "string", "minLength": 1 },
        "olcu_birimi":                 { "$ref": "#/$defs/olcuBirimi" },
        "fasil_no":                    { "type": "string", "pattern": "^[0-9]{2}$" },
        "pozisyon_no":                 { "type": ["string", "null"], "pattern": "^[0-9]{4}$" },
        "alt_pozisyon_no":             { "type": ["string", "null"], "pattern": "^[0-9]{6}$" },
        "cn_kodu":                     { "type": ["string", "null"], "pattern": "^[0-9]{8}$" },
        "milli_alt_acilim_kodu":       { "type": ["string", "null"], "pattern": "^[0-9]{10}$" },
        "istatistik_acilim_kodu":      { "type": ["string", "null"], "pattern": "^[0-9]{12}$" },
        "seviye":                      { "type": "integer", "enum": [2, 4, 6, 8, 10, 12] },
        "yaprak_mi":                   { "type": "boolean" },
        "parent_alt_pozisyon_no":      { "type": ["string", "null"] },
        "parent_cn_kodu":              { "type": ["string", "null"] },
        "parent_milli_alt_acilim_kodu":{ "type": ["string", "null"] },
        "parent_istatistik_acilim_kodu":{ "type": ["string", "null"] },
        "tam_yol":                     { "type": "string" },
        "etiketler":                   { "type": "array", "items": { "type": "string" }, "default": [] },
        "meta":                        { "$ref": "#/$defs/gtipMeta" },
        "kurumlar":                    { "$ref": "#/$defs/kurumBloklari" },
        "ek_alanlar":                  { "type": "object", "additionalProperties": true, "default": {} }
      },
      "additionalProperties": false
    },

    "fasilMeta": {
      "type": "object",
      "description": "Fasıl dosyası üst meta bilgisi",
      "required": [
        "dosya_surumu",
        "schema_surumu",
        "surum",
        "yayinci",
        "kaynak",
        "fasil_no",
        "fasil_adi",
        "toplam_kayit",
        "yayin_durumu"
      ],
      "properties": {
        "dosya_surumu":        { "type": "string" },
        "schema_surumu":       { "type": "string" },
        "surum":               { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}$" },
        "surum_onceki":        { "type": ["string", "null"] },
        "guncelleme":          { "$ref": "#/$defs/tarih" },
        "yayinci":             { "type": "string" },
        "birim":               { "type": "string" },
        "kaynak":              { "type": "string" },
        "gecerlilik_baslangic":{ "$ref": "#/$defs/tarih" },
        "gecerlilik_bitis":    { "$ref": "#/$defs/tarih" },
        "fasil_no":            { "type": "string", "pattern": "^[0-9]{2}$" },
        "fasil_adi":           { "type": "string", "minLength": 1 },
        "toplam_kayit":        { "type": "integer", "minimum": 0 },
        "toplam_yaprak":       { "type": "integer", "minimum": 0 },
        "yayin_durumu": {
          "type": "string",
          "enum": ["taslak", "yayinda", "arsiv"]
        },
        "hash":       { "type": ["string", "null"] },
        "aciklama":   { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },

  "type": "object",
  "required": ["meta", "kayitlar"],
  "properties": {
    "meta":     { "$ref": "#/$defs/fasilMeta" },
    "kayitlar": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/gtipKaydi" }
    }
  },
  "additionalProperties": false,

  "examples": [
    {
      "meta": {
        "dosya_surumu": "1.0.0",
        "schema_surumu": "1.0.0",
        "surum": "2026.10.08",
        "surum_onceki": "2026.01.15",
        "guncelleme": "2026-10-08",
        "yayinci": "T.C. Ticaret Bakanlığı",
        "birim": "Gümrükler Genel Müdürlüğü",
        "kaynak": "Resmi Gazete 2025/12",
        "gecerlilik_baslangic": "2026-01-01",
        "gecerlilik_bitis": "2026-12-31",
        "fasil_no": "27",
        "fasil_adi": "Mineral Yakıtlar, Mineral Yağlar ve Bunların Damıtılmasından Elde Edilen Ürünler; Bitümenli Maddeler; Mineral Mumlar",
        "toplam_kayit": 16,
        "toplam_yaprak": 16,
        "yayin_durumu": "yayinda"
      },
      "kayitlar": [
        {
          "gtip_ham": "270112100000",
          "kod": "2701.12.10.00.00",
          "aciklama": "Kokluk taşkömürü",
          "olcu_birimi": "KG",
          "fasil_no": "27",
          "pozisyon_no": "2701",
          "alt_pozisyon_no": "270112",
          "cn_kodu": "27011210",
          "milli_alt_acilim_kodu": "2701121000",
          "istatistik_acilim_kodu": "270112100000",
          "seviye": 12,
          "yaprak_mi": true,
          "parent_alt_pozisyon_no": "270112",
          "parent_cn_kodu": "27011210",
          "tam_yol": "27 > 2701 > 2701.12 > 2701.12.10 > 2701.12.10.00 > 2701.12.10.00.00",
          "etiketler": ["kömür", "kok-üretimi", "stratejik", "demir-çelik"],
          "meta": {
            "olusturma_tarihi": "2026-01-15",
            "guncelleme_tarihi": "2026-01-15",
            "kaynak": "Resmi Gazete 2025/12",
            "resmi_mi": true,
            "yayinci": "T.C. Ticaret Bakanlığı"
          },
          "kurumlar": {
            "hazine_maliye": {
              "kdv_orani": 20,
              "otv_orani": 0,
              "otv_durumu": "muaf",
              "nace_kodu": "05.10.01",
              "meta": {
                "giris_tarihi": "2026-01-18",
                "guncelleme_tarihi": "2026-01-18",
                "giren_kurum": "GİB",
                "onay_durumu": "onaylandi"
              }
            },
            "ticaret": {
              "ithalat_rejimi": "Serbest",
              "ihracat_rejimi": "Serbest",
              "gozetim_gerekli": true,
              "borsa_tescil_zorunlu": true,
              "randiman_iliskileri": [
                {
                  "yon": "girdi",
                  "gtip_ham_karsi": "270400100000",
                  "islem_adi": "Koklaştırma (Taşkömürü → Kok)",
                  "asgari_randiman": 70.0,
                  "azami_fire": 12.0,
                  "ikincil_urunler": [
                    { "ad": "Kok gazı", "gtip_ham": "270500000000", "oran": 10.0 },
                    { "ad": "Katran", "gtip_ham": "270600000011", "oran": 5.0 }
                  ]
                }
              ],
              "meta": {
                "giris_tarihi": "2026-01-22",
                "giren_kurum": "Ticaret Bakanlığı",
                "onay_durumu": "onaylandi"
              }
            },
            "enerji": {
              "kalori_min_kcal_kg": 6500,
              "maden_ruhsati_gerekli": true,
              "ruhsat_turu": "İşletme Ruhsatı",
              "maden_grubu": "IV. Grup",
              "meta": {
                "giris_tarihi": "2026-03-01",
                "giren_kurum": "MAPEG",
                "onay_durumu": "onaylandi"
              }
            },
            "cevre": {
              "kukurt_max_yuzde": 1.0,
              "nem_max_yuzde": 8.0,
              "ced_gerekli": true,
              "ced_turu": "ÇED Raporu",
              "meta": {
                "giris_tarihi": "2026-01-28",
                "giren_kurum": "Çevre Bakanlığı",
                "onay_durumu": "onaylandi"
              }
            },
            "sanayi_teknoloji": {
              "zorunlu_standart": "TS 5125",
              "standart_adi": "Kömür — Isınma ve Sanayi Amaçlı",
              "tse_belgesi_gerekli": false,
              "meta": {
                "giris_tarihi": "2025-06-01",
                "giren_kurum": "TSE",
                "onay_durumu": "onaylandi"
              }
            }
          }
        }
      ]
    }
  ]
}